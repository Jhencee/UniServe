# The API lives below the repository root; the frontend deploys separately.
load("//anybuild/tools:php.bzl", "php_build", "php_config", "php_serve")

config = php_config(
    schema = 1,
    php_framework = "laravel",
    # Anybuild maps the minor version to Wasmer's published PHPix package.
    php_version = "8.4",
    composer_enable = True,
    php_public_dir = "public",
    commands = {
        "install": "composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction",
        "build": "php artisan config:clear",
        # Runs as a Wasmer deployment job with runtime database configuration.
        # Stop before migrations if the encrypted database backup fails.
        "after_deploy": "bash -c 'php scripts/verify-mfa-runtime.php && php artisan backup:create && php artisan migrate --force --path=database/migrations/2026_11_13_170000_add_staff_mfa.php && php artisan migrate --force --path=database/migrations/2026_11_17_000001_create_staff_trusted_devices.php && php artisan migrate:status'",
    },
)

build = php_build(config)
# Copy the Laravel application before the provider's Composer install step.
# A subdirectory marker alone did not populate /app in the Wasmer build.
php_serve(
    config,
    build,
    name = "uniserve-api",
    build_pre = [
        copy("backend/", "/app", ignore = [".env", ".env.*", "vendor", "node_modules", "storage/logs/*"]),
    ],
)
